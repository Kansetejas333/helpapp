<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#EEEEEE"
            android:textColor="#000000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAccessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Accessibility settings" />

        <Switch
            android:id="@+id/enabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Auto-accept ON"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Driver app package name (required)" />
        <EditText
            android:id="@+id/packageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. com.example.driverapp"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Accept button text (comma separated)" />
        <EditText
            android:id="@+id/labelsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Accept"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Accept button view ID (optional, faster)" />
        <EditText
            android:id="@+id/viewIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. com.example.driverapp:id/accept_btn"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Minimum fare in ₹ (leave empty for no limit)" />
        <EditText
            android:id="@+id/minFareInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Maximum pickup distance in km (leave empty for no limit)" />
        <EditText
            android:id="@+id/maxKmInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fare and distance are read from the offer screen on a best-effort basis (first ₹ amount and first km/m value). If a value can't be read, that filter is skipped for the offer. Using auto-accept may break your driver app's terms of service." />
    </LinearLayout>
</ScrollView>
